		capabalities are expressed as interfaces and enforced by the compiler.</PackageDescription>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

	</PropertyGroup>
	<ItemGroup>
	  <PackageReference Include="Melville.Generators.INPC" />
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\Melville.IntersectionTypes\Melville.IntersectionTypes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
	</ItemGroup>
</Project>